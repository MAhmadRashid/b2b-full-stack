# ==========================================
# PulseFlow Enterprise Telemetry Platform
# Environment Configuration Template
# ==========================================

# Database Connection (SQLite in development, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Use a cryptographically secure 64+ char random hex)
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="PulseFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"
