# ==============================================================================
# PulseFlow Enterprise B2B SaaS Platform - Production Environment Variables
# ==============================================================================
# WARNING: NEVER commit actual secret values or .env files into version control.
# Copy this template to .env and configure values through your hosting provider's
# secure secret vault (e.g., Vercel Project Settings, Railway Variables, AWS SSM).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_NAME="PulseFlow Telemetry"
NEXT_PUBLIC_APP_URL="https://app.pulseflow.io"

# ------------------------------------------------------------------------------
# 2. DATABASE & CONNECTION POOLING
# ------------------------------------------------------------------------------
# For Local/Staging Development (SQLite):
# DATABASE_URL="file:./prisma/dev.db"
#
# For Production (PostgreSQL with PgBouncer / Supabase / Neon):
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&pgbouncer=true&connection_limit=20
DATABASE_URL="postgresql://pulseflow_admin:YOUR_SECURE_DB_PASSWORD@ep-db-pooler.neon.tech/pulseflow?sslmode=require&pgbouncer=true"

# Direct URL for Prisma migrations (bypassing connection pooler):
# DIRECT_URL="postgresql://pulseflow_admin:YOUR_SECURE_DB_PASSWORD@ep-db-direct.neon.tech/pulseflow?sslmode=require"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 64 (minimum 32 characters required)
JWT_SECRET="replace_with_a_cryptographically_secure_64_character_random_hex_string"

# Optional custom cookie domain for multi-subdomain session sharing (e.g. .pulseflow.io)
# COOKIE_DOMAIN=".pulseflow.io"

# ------------------------------------------------------------------------------
# 4. BILLING, PAYMENTS & SUBSCRIPTIONS (Stripe)
# ------------------------------------------------------------------------------
# Leave empty to keep platform in safe Sandbox Mode during staging/smoke testing.
# Obtain keys from Stripe Dashboard -> Developers -> API Keys / Webhooks.
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & INVITATIONS
# ------------------------------------------------------------------------------
# Option A: Resend (Recommended)
RESEND_API_KEY="re_replace_with_resend_api_key"
EMAIL_FROM="PulseFlow <notifications@pulseflow.io>"

# Option B: Standard SMTP Relay (Alternative)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@pulseflow.io"
# SMTP_PASS="replace_with_smtp_password"

# ------------------------------------------------------------------------------
# 6. OPERATIONAL MONITORING & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
RATE_LIMIT_ENABLED="true"
